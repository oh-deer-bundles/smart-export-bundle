{% use 'form_div_layout.html.twig' %}

{% block form_row_render %}
    <div class="mb-4">
        {{ form_label(form) }}
        {{ form_errors(form) }}
        {{ form_widget(form, widget_attr) }}
        {{ form_help(form) }}
    </div>
{% endblock %}

{% block form_label %}
    {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' mb-1 block text-sm font-medium text-slate-700 dark:text-slate-300')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block form_widget_simple %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' block w-full rounded-md border-0 bg-white px-3 py-1.5 text-slate-900 ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 disabled:bg-slate-100 disabled:text-slate-500 dark:bg-slate-800 dark:text-slate-100 dark:ring-slate-700 dark:disabled:bg-slate-900 dark:disabled:text-slate-500 sm:text-sm')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block choice_widget_collapsed %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' block w-full rounded-md border-0 bg-white px-3 py-1.5 text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 dark:bg-slate-800 dark:text-slate-100 dark:ring-slate-700 sm:text-sm')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block checkbox_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-600 dark:border-slate-600 dark:bg-slate-800')|trim}) %}
    {{ parent() }}
{% endblock %}

{#
    Widget block for Odb\SmartExportBundle\Form\Type\FilterOptionBooleanType — the block
    name is auto-derived by Symfony from the class name, so a host app can override just
    this block in its own form theme without touching anything else. The built-in
    choice_widget_expanded this would otherwise inherit never renders each radio's own
    label in this app's form theming stack (long-standing, unexplained quirk with
    expanded ChoiceType children), so labels are built by hand here instead.
#}
{% block filter_option_boolean_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' flex items-center gap-4')|trim}) %}
    <div {{ block('widget_container_attributes') }}>
        {% for child in form %}
            {% set boolLabelKey = child.vars.value == '1' ? 'seb.filter.boolean.yes' : (child.vars.value == '0' ? 'seb.filter.boolean.no' : 'seb.filter.boolean.unfiltered') %}
            <label class="mr-4 inline-flex items-center gap-1 text-sm text-slate-700 dark:text-slate-300">
                {{ form_widget(child) }}
                {{ boolLabelKey|trans({}, 'smart_export_bundle_forms') }}
            </label>
        {% endfor %}
    </div>
{% endblock %}

{% block form_help %}
    {% set help_attr = help_attr|merge({class: (help_attr.class|default('') ~ ' mt-1 text-xs text-slate-500 dark:text-slate-400')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="mt-1 text-xs text-red-600 dark:text-red-400">
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
