{% extends '@OdbSmartExport/_layout.html.twig' %}
{% form_theme formExport '@OdbSmartExport/form/tailwind_layout.html.twig' %}
{% block body %}
    <turbo-frame id="demo-export-frame" class="block w-full">
        <div data-controller="dual-list" class="w-full space-y-6">
            {{ form_start(formExport, {'attr': {
                'data-turbo': 'false',
                'action': url('odb_smart_export_admin_demo_export',{'uuid':uuid,'token': csrf_token('export_generate')}),
            }}) }}

            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Demo export</h2>

            <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4">
                <ul data-dual-list-target="available" data-action="dragover->dual-list#allowDrop drop->dual-list#dropOnAvailable"
                    class="h-52 list-none overflow-y-auto rounded-md border border-slate-300 bg-white p-2 text-sm dark:border-slate-700 dark:bg-slate-800">
                    {% for choiceView in formExport.choices.vars.choices %}
                        <li draggable="true" data-dual-list-target="item" data-value="{{ choiceView.value }}"
                            data-action="click->dual-list#toggleSelect dragstart->dual-list#dragStart"
                            class="cursor-pointer select-none rounded px-2 py-1 hover:bg-slate-100 dark:hover:bg-slate-700">{{ choiceView.label }}</li>
                    {% endfor %}
                    {% do formExport.choices.setRendered %}
                </ul>

                <div class="flex flex-col gap-2">
                    <button type="button" data-dual-list-target="chooseAll" data-action="click->dual-list#chooseAll"
                            class="rounded-md bg-indigo-600 px-2 py-1 text-sm text-white hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-slate-300 dark:disabled:bg-slate-700">&raquo;</button>
                    <button type="button" data-dual-list-target="chooseSelected" data-action="click->dual-list#chooseSelected"
                            class="rounded-md bg-indigo-100 px-2 py-1 text-sm text-indigo-700 hover:bg-indigo-200 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-400 dark:bg-indigo-900/40 dark:text-indigo-200 dark:hover:bg-indigo-900/60 dark:disabled:bg-slate-800 dark:disabled:text-slate-600">&rsaquo;</button>
                    <button type="button" data-dual-list-target="resetSelected" data-action="click->dual-list#resetSelected"
                            class="rounded-md bg-indigo-100 px-2 py-1 text-sm text-indigo-700 hover:bg-indigo-200 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-400 dark:bg-indigo-900/40 dark:text-indigo-200 dark:hover:bg-indigo-900/60 dark:disabled:bg-slate-800 dark:disabled:text-slate-600">&lsaquo;</button>
                    <button type="button" data-dual-list-target="resetAll" data-action="click->dual-list#resetAll"
                            class="rounded-md bg-indigo-600 px-2 py-1 text-sm text-white hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-slate-300 dark:disabled:bg-slate-700">&laquo;</button>
                </div>

                <ul data-dual-list-target="chosen" data-action="dragover->dual-list#allowDrop drop->dual-list#dropOnChosen"
                    class="h-52 list-none overflow-y-auto rounded-md border border-slate-300 bg-white p-2 text-sm dark:border-slate-700 dark:bg-slate-800"></ul>
            </div>

            {{ form_widget(formExport.fields, {'attr': {'data-dual-list-target': 'input'}}) }}

            {{ form_row(formExport.file_format) }}
            {{ form_row(formExport.separator) }}
            {{ form_row(formExport.charset) }}

            <div class="flex justify-end">
                <button type="submit"
                        class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500">Generate</button>
            </div>
            {{ form_end(formExport) }}
        </div>
    </turbo-frame>
{% endblock %}
