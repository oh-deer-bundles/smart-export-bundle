{% extends '@OdbSmartExport/_layout.html.twig' %}
{% form_theme formEditEngine '@OdbSmartExport/form/tailwind_layout.html.twig' %}
{% import _self as formMacros %}


{% block body %}
    <div data-controller="dialog">
        <h1 class="mb-6 text-center text-2xl font-semibold text-slate-900 dark:text-white">Edit export</h1>

        {{ form_start(formEditEngine) }}
        <div class="mb-6 rounded-lg bg-white shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700">
            <div class="flex items-center gap-4 border-b border-slate-200 px-6 py-4 dark:border-slate-700">
                <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Engine</h2>
                <div class="flex items-center gap-2">
                    {{ form_widget(formEditEngine.enabled) }}
                    {{ form_label(formEditEngine.enabled) }}
                </div>
            </div>
            <div class="grid grid-cols-1 gap-x-6 gap-y-4 px-6 py-4 sm:grid-cols-2">
                {{ form_row(formEditEngine.name) }}
                {{ form_row(formEditEngine.code) }}
                {{ form_row(formEditEngine.description) }}
                {{ form_row(formEditEngine.className) }}
            </div>
        </div>

        <div class="mb-6 rounded-lg bg-white shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-700"
             {{ stimulus_controller('form-collection', { prototype: formMacros.render_form_smart_export_column(formEditEngine.columns.vars.prototype, true)|json_encode}) }}>
            <div class="border-b border-slate-200 px-6 py-4 dark:border-slate-700">
                <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Colonnes</h2>
            </div>
            <div class="overflow-x-auto px-6 py-4">
                <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
                    <thead>
                    <tr>
                        <th class="w-12"></th>
                        <th class="min-w-[12rem] px-2 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Property</th>
                        <th class="px-2 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Label</th>
                        <th class="px-2 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Export label</th>
                        <th class="px-2 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Group Cell</th>
                        <th class="px-2 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Interpreter</th>
                        <th class="px-2 py-2 text-center text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Filterable</th>
                        <th class="px-2 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Filter widget</th>
                        <th class="min-w-[8rem] px-2 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Default filter value</th>
                        <th class="w-12"></th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-800" {{ stimulus_target('form-collection', 'fields') }}>
                    {% do formEditEngine.columns.setRendered %}
                    {% for formColumn in formEditEngine.columns %}
                        {{ formMacros.render_form_smart_export_column(formColumn) }}
                    {% endfor %}
                    </tbody>
                </table>
                <div class="mt-4 flex justify-end">
                    <button type="button"
                            class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500"
                            {{ stimulus_action('form-collection', 'addItem') }} {{ stimulus_target('form-collection', 'addButton') }}>Add column</button>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3">
            <button type="button" data-action="click->dialog#open"
                    class="inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-red-500">Delete export</button>
            <a href="{{ url('odb_smart_export_admin_index')}}"
               class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-medium text-slate-700 ring-1 ring-inset ring-slate-300 hover:bg-slate-50 dark:bg-slate-800 dark:text-slate-200 dark:ring-slate-600 dark:hover:bg-slate-700">Cancel</a>
            <button type="submit"
                    class="inline-flex items-center rounded-md bg-amber-500 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-amber-400">Save</button>
        </div>
        {{ form_end(formEditEngine) }}

        <dialog data-dialog-target="dialog" data-action="click->dialog#closeOnBackdrop"
                class="w-full max-w-md rounded-lg bg-white p-0 text-slate-900 shadow-xl backdrop:bg-slate-900/50 dark:bg-slate-900 dark:text-slate-100">
            <div class="border-b border-slate-200 px-6 py-4 dark:border-slate-700">
                <h2 class="text-lg font-semibold">Delete export {{ formEditEngine.vars.value.name ?: formEditEngine.vars.value.code }}</h2>
            </div>
            <div class="px-6 py-4">
                <p class="mb-2 text-center text-xl font-semibold text-red-600 dark:text-red-400">Attention !</p>
                <p class="text-sm text-slate-700 dark:text-slate-300">
                    Vous êtes sur le point de supprimer l'export <b>{{ formEditEngine.vars.value.name ?: formEditEngine.vars.value.code }}</b>.<br>
                    Cette action est irréversible, toutes données seront perdues !
                </p>
            </div>
            <div class="flex justify-end gap-3 border-t border-slate-200 px-6 py-4 dark:border-slate-700">
                <button type="button" data-action="click->dialog#close"
                        class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-medium text-slate-700 ring-1 ring-inset ring-slate-300 hover:bg-slate-50 dark:bg-slate-800 dark:text-slate-200 dark:ring-slate-600 dark:hover:bg-slate-700">Annuler</button>
                <a href="{{ url('odb_smart_export_admin_remove',{'uuid':uuid}) }}"
                   class="inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-red-500">Delete</a>
            </div>
        </dialog>
    </div>
{% endblock %}

{% macro render_form_smart_export_column(formColumn, whitHelper = false) %}
    <tr class="item" {{ stimulus_target('form-collection','field') }}>
        <td class="px-2 py-2 align-top">
            <div class="flex flex-col gap-1 text-slate-400">
                <button type="button" class="hover:text-slate-700 dark:hover:text-slate-200" {{ stimulus_action('click->form-collection','rowUp') }}>⬆</button>
                <button type="button" class="hover:text-slate-700 dark:hover:text-slate-200" {{ stimulus_action('click->form-collection','rowDown') }}>⬇</button>
            </div>
            {{ form_widget(formColumn.choicePosition) }}
        </td>
        <td class="px-2 py-2 align-top">
            {{ form_widget(formColumn.classProperty) }}
            {% if whitHelper %}
                {{ form_help(formColumn.classProperty) }}
            {% endif %}
        </td>
        <td class="px-2 py-2 align-top">
            {{ form_widget(formColumn.choiceLabel) }}
            {% if whitHelper %}
                {{ form_help(formColumn.choiceLabel) }}
            {% endif %}
        </td>
        <td class="px-2 py-2 align-top">
            {{ form_widget(formColumn.headerLabel) }}
            {% if whitHelper %}
                {{ form_help(formColumn.headerLabel) }}
            {% endif %}
        </td>
        <td class="px-2 py-2 align-top">
            {{ form_widget(formColumn.cellGroupIndex) }}
            {% if whitHelper %}
                {{ form_help(formColumn.cellGroupIndex) }}
            {% endif %}
        </td>
        <td class="px-2 py-2 align-top">
            {{ form_widget(formColumn.interpreter) }}
            {% if whitHelper %}
                {{ form_help(formColumn.interpreter) }}
            {% endif %}
        </td>
        <td class="px-2 py-2 align-top text-center">
            {{ form_widget(formColumn.filterable) }}
            {% if whitHelper %}
                {{ form_help(formColumn.filterable) }}
            {% endif %}
        </td>
        <td class="px-2 py-2 align-top">
            {{ form_widget(formColumn.filterWidget) }}
            {% if whitHelper %}
                {{ form_help(formColumn.filterWidget) }}
            {% endif %}
        </td>
        <td class="px-2 py-2 align-top">
            {{ form_widget(formColumn.filterDefaultValue) }}
            {% if whitHelper %}
                {{ form_help(formColumn.filterDefaultValue) }}
            {% endif %}
        </td>
        <td class="px-2 py-2 align-top text-right">
            <button type="button"
                    class="inline-flex items-center rounded-md bg-red-600 px-2 py-1 text-xs text-white shadow-sm hover:bg-red-500"
                    {{ stimulus_action('form-collection','removeItem') }}>🗑️</button>
        </td>
    </tr>
{% endmacro %}
