{
    "name": "oh-deer-bundles/smart-export-bundle",
    "description": "Symfony Bundle helps for export data to file",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-iconv": "*",
        "ext-zip": "*",
        "phpoffice/phpspreadsheet": "^5.7",
        "psr/cache": "^3.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/form": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/orm-pack": "^2.4",
        "symfony/security-bundle": "^7.4",
        "symfony/string": "^7.4",
        "symfony/validator": "^7.4"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^7.4",
        "symfony/browser-kit": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Odb\\SmartExportBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Odb\\SmartExportBundle\\Tests\\": "tests/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Fabrice GARES"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-sf74": "1.0.x-dev"
        }
    }
}
